PORT=8787
ALLOWED_ORIGIN=https://service.hottubfactoryoutlet.com,https://hottubfactoryoutlet.com,https://www.hottubfactoryoutlet.com
STORE_RETURN_URL=https://rayjmorrow.github.io/Hot-Tub-Factory-Outlet/order-return.html
STORE_CANCEL_URL=https://rayjmorrow.github.io/Hot-Tub-Factory-Outlet/cart.html
TAXJAR_API_KEY=replace_me
TAXJAR_SANDBOX=true
AUTHORIZE_API_LOGIN_ID=replace_me
AUTHORIZE_TRANSACTION_KEY=replace_me
AUTHORIZE_SANDBOX=true
SHIP_FROM_COUNTRY=US
SHIP_FROM_STATE=PA
SHIP_FROM_ZIP=replace_me
SHIP_FROM_CITY=replace_me
SHIP_FROM_STREET=replace_me

# HTFO private service operations portal
# Deploy this backend behind HTTPS at https://service.hottubfactoryoutlet.com.
# The backend serves the login page and approved portal assets itself; the API remains same-origin.
# Use a persistent PostgreSQL database; never expose these values in frontend code.
DATABASE_URL=replace_me
DATABASE_SSL=true
SERVICE_PORT=8790
SERVICE_JWT_SECRET=replace_with_at_least_32_random_bytes
# These bootstrap the first administrator only if that username does not already exist.
# Set Ray as the initial administrator in the hosting provider's secret/environment settings.
SERVICE_ADMIN_USER=replace_me
SERVICE_ADMIN_PASSWORD=replace_with_a_unique_strong_password
SERVICE_ADMIN_NAME=Ray

# Built-in HTFO employee discount codes: BILL10, RICK10, RAY10, GINA10.
# Each valid code gives 10% off the current purchase. If AutoShip starts on that order,
# the active subscription keeps 10% off the then-current regular price until canceled.
# Optional: add/override codes with {"CODE":{"name":"Employee Name","id":"employee-id"}}.
EMPLOYEE_CODES_JSON={}
